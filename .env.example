# Пример файла с настройками. Скопируйте его в .env и впишите свои значения.
# Файл .env в репозиторий не добавляется.

# секретный ключ для подписи cookie (любая длинная случайная строка)
SECRET_KEY=впишите-сюда-случайную-строку

# где лежит файл базы данных
DB_PATH=/data/gymlog.db

# тестовый аккаунт для проверки (создаётся при запуске)
TEST_EMAIL=test@gymlog.ru
TEST_PASSWORD=test12345
